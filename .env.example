# Travel Buddy AI - Environment Variables Template

# ------------------------------------------------------------------------------
# API KEYS (Required for AI features)
# ------------------------------------------------------------------------------

# OpenAI: Used for BOTH Whisper (STT) and GPT-4 (Intent/Summarization/Expenses)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional Fallbacks & Enhanced Features
DEEPGRAM_API_KEY=your-deepgram-key-here (optional)
OPENWEATHERMAP_API_KEY=your-openweather-key-here (for weather alerts)
GOOGLE_MAPS_API_KEY=your-google-maps-key-here (for traffic alerts)
NEWS_API_KEY=your-newsapi-key-here (for news alerts)

# ------------------------------------------------------------------------------
# DATABASE & STORAGE
# ------------------------------------------------------------------------------

# Path to the local SQLite database file.
# Relative paths are resolved from backend/, so this points to backend/travel_buddy.db.
DB_PATH=travel_buddy.db

# Cloud database URL. Leave empty for local SQLite development.
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Local Firebase Admin credential file path.
FIREBASE_CREDENTIALS_PATH=backend/firebase_service_account.json

# Cloud Firebase Admin credentials. Use ONE of these in cloud instead of uploading JSON files.
# FIREBASE_CREDENTIALS_JSON can be a one-line service account JSON string.
# FIREBASE_CREDENTIALS_BASE64 can be base64 of the service account JSON.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_BASE64=

# ------------------------------------------------------------------------------
# PERFORMANCE & TUNING
# ------------------------------------------------------------------------------

# Chosen OpenAI Models
OPENAI_MODEL=gpt-4-turbo
WHISPER_MODEL=whisper-1

# Max audio length for transcription (in seconds)
MAX_AUDIO_DURATION=300

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------

# Secret key for session/cookie security (if used in future)
SECRET_KEY=generate-a-random-hex-string-here

# Deployment safety
ENVIRONMENT=development
AUTH_BYPASS=false
ALLOWED_ORIGINS=
